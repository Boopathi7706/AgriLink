# =================================================================
# AgriLink - Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to create your local .env file:
#      Windows (PowerShell): Copy-Item .env.example .env
#      Linux / macOS:        cp .env.example .env
# 2. Update DATABASE_PASSWORD with your chosen local secret.
# 3. DO NOT commit the .env file to Git repository.
# =================================================================

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------
POSTGRES_DB=agrilink
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JDBC URL for local backend running on host machine:
DATABASE_URL=jdbc:postgresql://localhost:5432/agrilink

# Optional: Host PostgreSQL Port Mapping (default: 5432)
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# Application Server Configuration
# -----------------------------------------------------------------
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------
# Future Services Configuration (Phase 2+)
# -----------------------------------------------------------------
# JWT Secret (min 256-bit / 32 characters for HMAC-SHA256)
JWT_SECRET=replace_with_a_long_random_secret_string_for_local_dev
JWT_EXPIRY_MINUTES=60

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8001

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# File Storage
STORAGE_MODE=local
UPLOADS_DIR=./uploads
