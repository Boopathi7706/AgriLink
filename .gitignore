# =================================================================
# AgriLink - Root .gitignore
# =================================================================

# Backend / Java / Maven
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.properties

# Frontend / Node
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.next/
out/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ML Service / Python
ml-service/venv/
ml-service/.venv/
venv/
.venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
ml-service/artifacts/*.h5
ml-service/artifacts/*.pkl
*.h5
*.pkl
*.pt
*.onnx
*.joblib
.pytest_cache/
.coverage
htmlcov/

# Environment and Local Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary Local Uploads
logs/
*.log
uploads/
scratch/
tmp/
